#!/usr/bin/env bash
# Map JTAG probes to the selector each tool wants, resolved at run time from the
# probe's USB serial number.
#
# Port paths (1-4, 1-7, ...) move when you replug, so nothing here hardcodes
# them. Serial numbers are fixed per probe, so a board alias resolves to a
# serial, and the serial resolves to whatever the tool needs right now:
#
#   Quartus          cable name "<usb product> [<port-path>]" -- the suffix IS
#                    the sysfs port path, and the prefix is the USB product
#                    string, which differs between a real Altera cable
#                    ("USB-Blaster") and pico-usb-blaster ("USB Blaster")
#   openFPGALoader   --busdev-num <bus>:<dev> -- BUT ONLY WITH THE PATCHED
#                    BUILD. Stock openFPGALoader (including the Debian package)
#                    accepts --busdev-num and --cable-index and IGNORES BOTH:
#                    libusb_open_device_with_vid_pid() returns the first match,
#                    so with two identical probes it always takes whichever
#                    enumerated first. Verified 2026-08-07 by asking for a
#                    bus:dev that does not exist -- it happily detected a chip.
#                    Fix: ~/workspaces/openfpgaloader-dirtyjtag-busdev.patch,
#                    built and installed to /usr/local/bin (shadows the .deb).
#                    A patched build FAILS on a bogus bus:dev; that is the test.
#                    NOTE the patch covers dirtyJtag only -- the usb-blaster
#                    driver still has the same bug.
#
# TWO BLASTERS ARE ATTACHED (since 2026-08-29). The level shifters arrived, and
# a pico-usb-blaster now drives the EP4CGX150 while the Terasic stays on the
# A-E115FB, so neither board needs the cable moved any more. Two blasters at
# once means selection must be by USB ADDRESS, not by product name:
#   - Quartus is fine. Always pass the PORT-QUALIFIED name from `--cable`
#     ("USB-Blaster [1-6]"); a bare "USB-Blaster" takes the first product-string
#     match. Board Makefiles should never hardcode the bare string -- the
#     EP4CGX150 one did until 2026-08-17.
#   - openFPGALoader is NOT fine: the patch above covers dirtyJtag only, so its
#     usb-blaster driver still ignores --busdev-num and grabs the first match.
#     Use Quartus for usb-blaster cables until that is patched too.
#   - Lucky break: the product strings differ ("USB-Blaster" vs "USB Blaster"),
#     so the two are distinguishable even before the port path is considered.
#     Do not lean on it -- --cable reads the product string from sysfs and
#     appends the port path, which separates two probes of the SAME kind too.
#
# Companion to usb_serial_map, which does the same job for serial ports.
set -euo pipefail

# --- board registry ------------------------------------------------------
# alias|serial|kind|description
BOARDS=$(cat <<'EOF'
terasic|91d28408|usb-blaster|Terasic USB-Blaster — a CABLE, not a board; SWAPPED onto the EP4CGX150 on 2026-08-31, so `terasic` and `ep4cgx150` now resolve alike
xc7a100t|E662C876C3506A26|pico|QMTECH XC7A100T + DB_FPGA V5. The RP2040 is ON the DB_FPGA V5 itself, so this alias names a BOARD and the serial is permanent. Full 16-char RP2040 serial: `serial_matches` is a bidirectional prefix test, so it still matches the 8 chars pico-usb-blaster reports, whereas an 8-char entry would also match a different Pico sharing that prefix
ae115fb|e6616408|usb-blaster|A-E115FB EP4CE115 + 1GB DDR2 — on the LEVEL-SHIFTED Pico (product "USB Blaster", no hyphen) since the 2026-08-31 swap. The bare Pico that once drove 3.3V into this board's JTAG bank is not this cable; the shifter references VTREF
ep4cgx150|91d28408|usb-blaster|QMTECH EP4CGX150 + SDR — on the Terasic since the 2026-08-31 swap, to take the intermittent Pico out of the picture while item 101's control build is run (item 100)
debugprobe|E6647C740343412F|cmsis-dap|Raspberry Pi Debug Probe (SWD, for flashing Picos)
cyc5000|ARA30135|arrow-usb-blaster|Arrow CYC5000 (onboard Arrow USB Blaster TEI0050, FT2232H)
i5|07000001002700424e|cmsis-dap|Colorlight i5 on the ext board (DAPLink, also the UART bridge)
wukong|0B383D0435D957EC|pico|QMTECH Wukong XC7A100T (Pico 2 W: dirtyJtag, or USB-Blaster emulation under the atari800 supervisor firmware). A STANDALONE Pico W -- a cable, not part of the board -- so this alias names whatever it is currently plugged into, the way `terasic` does. Unplugging it and using it elsewhere silently retargets this alias
alchitry|000000|ftdi-xilinx|Alchitry Au V2 (XC7A35T + DDR3) — onboard FT2232H, programmed by Vivado hw_server (see fpga/alchitry-au). Shares vid:pid 0403:6010 with the CYC5000's Arrow blaster; the serial and product string are what separate them. fpga/alchitry-au-ddr3-test is a second PROJECT on this same board, not another board
EOF
)

# vid:pid values we recognise as JTAG probes
is_probe_id() {
  case "${1,,}" in
    1209:c0ca|09fb:6001|2e8a:000c|0403:6010|0d28:0204) return 0 ;;
    *) return 1 ;;
  esac
}

probe_kind() {
  case "${1,,}" in
    1209:c0ca) echo "dirtyjtag" ;;
    09fb:6001) echo "usb-blaster" ;;
    2e8a:000c) echo "cmsis-dap" ;;
    # Arrow's onboard blaster is an FT2232H, so it shares a vid:pid with every
    # other FTDI dual-UART part -- including the Alchitry Au V2's. The SERIAL is
    # what separates them, so this case takes it as a second argument rather
    # than calling everything on 0403:6010 an Arrow blaster: the listing said
    # "arrow-usb-blaster" against the Alchitry, which is a different board's
    # probe. A listing that names the wrong probe is worse than one saying
    # "unknown", and this one helped conclude the Alchitry was not attached.
    0403:6010) case "${2:-}" in
                 ARA*) echo "arrow-usb-blaster" ;;
                 000000) echo "ftdi-xilinx" ;;
                 *) echo "ftdi-ft2232h" ;;
               esac ;;
    0d28:0204) echo "cmsis-dap" ;;
    *) echo "unknown" ;;
  esac
}

usage() {
  cat <<'USAGE'
Usage:
  jtag_probe_map                    list every attached JTAG probe
  jtag_probe_map --cable <alias>    print the Quartus cable name for a board
  jtag_probe_map --busdev <alias>   print bus:dev for openFPGALoader
  jtag_probe_map --serial <alias>   print the probe serial for a board
  jtag_probe_map --health           per-port USB enumeration health (needs dmesg)
  jtag_probe_map --boards           list known board aliases
  jtag_probe_map --assert-device <alias> [cable]
                                    scan the JTAG chain; fail unless the FPGA
                                    on it is the one <alias> expects

Aliases: terasic, xc7a100t, ae115fb, ep4cgx150, debugprobe, cyc5000, i5, wukong

NOTE: an alias names whatever the SERIAL is attached to. A Pico is soldered to
one board so its alias names that board; a standalone cable like the Terasic
moves, so it is named for the cable and you pick the board by plugging it in.

THE TWO ALTERA BOARDS HAVE SEPARATE CABLES since 2026-08-29 -- the Terasic on
the A-E115FB, a level-shifted pico-usb-blaster on the EP4CGX150 -- so the alias
does now imply the board. Keep running `--assert-device` anyway: two blasters
are attached at once, and quartus_pgm EXITS 0 ON A BROKEN CHAIN, so a
powered-off board otherwise programs "successfully". It is a read-only chain
scan and configures nothing; fpga/quartus.mk makes `program-sof` depend on it.

Examples:
  quartus_pgm -c "$(jtag_probe_map --cable ep4cgx150)" -m JTAG foo.cdf
  jtag_probe_map --assert-device ae115fb || exit 1   # before programming
  openFPGALoader -c dirtyJtag --busdev-num "$(jtag_probe_map --busdev xc7a100t)" foo.bit
USAGE
}

# --- expected FPGA per board ---------------------------------------------
# Written for boards that SHARED a cable: the Terasic served BOTH Altera boards
# until the EP4CGX150 got its own level-shifted Pico (2026-08-29), and until then
# `--cable ae115fb` and `--cable ep4cgx150` returned the same cable, so the alias
# did not prove which board was on the end of it.
#
# It earns its keep even now they are separate, for a different reason: nothing
# else in the flow notices a DEAD chain. quartus_pgm prints "Unable to read
# device chain - JTAG chain broken" and then "was successful. 0 errors", exit 0.
# Powered-off board, unplugged header, level shifter with no Vref -- every one of
# them programs "fine" unless this scan runs first.
#
# Keyed by JTAG IDCODE, NOT by device name. quartus_pgm reports the whole set of
# IDCODE-compatible parts and TRUNCATES it -- the A-E115FB's EP4CE115 prints as
# "10CL120(Y|Z)/EP3C120/.." because Cyclone IV E, Cyclone III and Cyclone 10 LP
# share IDCODE 020F70DD, and the name we want is inside the "..". Matching names
# therefore reports the wrong board on a correct one. The IDCODE itself is
# unambiguous, and it separates the two boards that share this cable, which is
# all this check has to do.
#
# alias|idcode|what it is.  idcode "?" = not yet recorded: the check then prints
# the detected value and asks for it, rather than guessing.
#
# THE VALUE IS WHAT THE SCANNING TOOL PRINTS, and the two tools differ in what
# they show, so the table stores each board's value as ITS backend reports it.
# openFPGALoader masks the Xilinx version nibble -- an XC7A100T is 0x13631093
# in the datasheet and prints as 0x3631093 -- so the recorded value is the
# masked one. Comparing tool output against a datasheet value would fail on a
# working board.
#
# TWO BOARDS SHARE 03631093: the Wukong and the DB_FPGA V5 both carry an
# XC7A100T. Each sits on its OWN dirtyJtag probe, and --busdev picks the probe;
# the IDCODE then confirms the part on the far end is the one the flow expects.
# It is the Altera pair that needed the IDCODE to separate boards, because those
# two once shared a cable.
#
# WHAT THIS CHECK THEREFORE CANNOT CATCH. The two Picos are not equivalent: the
# DB_FPGA V5 carries its RP2040 ON the board, so `xc7a100t` names a board and
# cannot drift; the Wukong is driven by a STANDALONE Pico W, a cable that can
# be unplugged and used elsewhere. Move that Pico W onto the DB_FPGA V5 and
# `--assert-device wukong` still PASSES -- same part, same IDCODE -- while
# pointing at the other board. Only the probe serial distinguishes them, and
# both Picos report the same USB product string ("Pico Dirty JTAG"), so the
# serial is the sole discriminator. This check proves the right PART is on the
# far end of the chosen probe; it does not prove the probe is on the right
# board.
#
# TWO BOARDS ARE DELIBERATELY ABSENT, because a recorded IDCODE would promise
# a check that cannot run:
#   alchitry  programmed through Vivado's hw_server, which neither backend
#             below drives.
#   cyc5000   quartus_pgm does not enumerate the Arrow USB Blaster at all --
#             `quartus_pgm -l` on 18.1 and 25.1 lists only the two Altera
#             blasters and never the Arrow FT2232H, so `-c "Arrow USB Blaster
#             TEI0050 [1-10]"` returns "Programming hardware cable not
#             detected" even with the board attached and enumerated on USB.
#             Measured 2026-09-04; openFPGALoader has an arrow-usb-blaster
#             cable that may work, and was not tried.
DEVICES=$(cat <<'EOF'
ae115fb|020F70DD|EP4CE115 (IDCODE shared with EP3C120 / 10CL120)
ep4cgx150|028040DD|EP4CGX150 — Cyclone IV GX
wukong|03631093|XC7A100T — Artix-7 (QMTECH Wukong)
xc7a100t|03631093|XC7A100T — Artix-7 (QMTECH core board + DB_FPGA V5)
i5|41111043|LFE5U-25 — ECP5
EOF
)

kind_for_alias() {
  local want="$1"
  while IFS='|' read -r alias serial kind desc; do
    [ "$alias" = "$want" ] && { echo "$kind"; return 0; }
  done <<<"$BOARDS"
  return 1
}

# WHICH TOOL CAN READ THIS BOARD'S CHAIN. quartus_pgm speaks to Altera blasters
# and nothing else, so scanning a Xilinx or Lattice board with it reports an
# empty chain -- indistinguishable from a powered-off board, and the diagnosis
# below would blame the hardware. Adding the IDCODEs without this would have
# turned "nothing to check" (honest) into a confident false failure (worse).
scan_backend() {
  case "$(kind_for_alias "$1" || echo unknown)" in
    usb-blaster|arrow-usb-blaster) echo quartus ;;
    pico|cmsis-dap)                echo ofl ;;
    *)                             echo none ;;
  esac
}

# openFPGALoader scan. Returns the 8-hex IDCODE on stdout, empty on failure.
#
# --busdev-num works for dirtyJtag only (the patched build in /usr/local/bin);
# the cmsis-dap driver ignores it, so with two CMSIS-DAP probes attached this
# selects whichever the driver finds first. Today that is unambiguous in
# practice -- the Debug Probe is SWD-only and exposes no JTAG chain -- but it
# is a real limitation, not a guarantee.
ofl_scan() {
  local want="$1" kind bd out
  kind=$(kind_for_alias "$want")
  case "$kind" in
    pico)      bd=$("$0" --busdev "$want") || return 1
               out=$(sudo -n timeout 90 openFPGALoader -c dirtyJtag --busdev-num "$bd" --detect 2>&1) || true ;;
    cmsis-dap) out=$(timeout 90 openFPGALoader -c cmsisdap --detect 2>&1) || true ;;
    *) return 1 ;;
  esac
  # "	idcode 0x3631093" -> 03631093
  local id
  id=$(grep -oE 'idcode 0x[0-9A-Fa-f]+' <<<"$out" | head -1 | grep -oE '[0-9A-Fa-f]+$') || true
  [ -n "$id" ] || return 1
  printf '%08X\n' "$((16#$id))"
}

# Scan the JTAG chain and fail unless the expected FPGA is the one attached.
# Read-only: it configures nothing.
assert_device() {
  local want="$1" cable="${2:-}" expect label found scan qpgm
  expect=""; label=""
  while IFS='|' read -r a i d; do
    [ "$a" = "$want" ] && { expect="$i"; label="$d"; break; }
  done <<<"$DEVICES"
  if [ -z "$expect" ]; then
    echo "no expected IDCODE recorded for '$want' -- nothing to check" >&2; return 0
  fi

  # NON-ALTERA BOARDS SCAN WITH openFPGALoader. Same contract as the Quartus
  # path below -- read-only, compare against the recorded IDCODE, name the
  # board on a mismatch -- but no retry loop: the flakiness that motivated the
  # 10 attempts was one marginal level-shifted Pico on the EP4CGX150, and
  # inventing retries for probes that have never needed them would hide a
  # genuine fault rather than report it. Raise it here if one proves marginal.
  local backend; backend=$(scan_backend "$want")
  if [ "$backend" = ofl ]; then
    local got
    if ! got=$(ofl_scan "$want"); then
      echo "JTAG chain scan for '$want' found no device (openFPGALoader)." >&2
      echo "  Usual cause is the BOARD being powered off; then an unplugged or" >&2
      echo "  reversed JTAG header. The probe enumerating on USB proves only" >&2
      echo "  that the CABLE is alive, not that the target is." >&2
      return 1
    fi
    if [ "$got" = "$expect" ]; then
      echo "$got  ($label)"; return 0
    fi
    echo "WRONG DEVICE for '$want': IDCODE $got, expected $expect ($label)." >&2
    return 1
  fi
  if [ "$backend" = none ]; then
    echo "no scan backend for '$want' -- neither quartus_pgm nor openFPGALoader drives it" >&2
    return 0
  fi

  [ -n "$cable" ] || cable=$("$0" --cable "$want") || return 1
  qpgm=${QUARTUS_PGM:-/opt/altera/18.1/quartus/bin/quartus_pgm}
  [ -x "$qpgm" ] || { echo "quartus_pgm not found at $qpgm (set QUARTUS_PGM)" >&2; return 1; }
  # RETRY, because a single scan is not evidence on a marginal cable.
  #
  # The EP4CGX150's level-shifted Pico detected 3 times in 10 on 2026-08-30 --
  # intermittent, not dead. Every check here had been a single scan, so a run of
  # unlucky samples read as a hard fault, and the message below names a
  # powered-off board as the usual cause. That is how a WORKING cable came to be
  # diagnosed as failed hardware.
  # 10 attempts. At the ~30 % hit rate measured on the EP4CGX150's Pico, six
  # was not enough: two of four checks still failed outright, so the failures
  # are BURSTY rather than independent -- which is itself a signal-integrity
  # fingerprint rather than random noise.
  #
  # Retry buys an honest ANSWER, not a usable cable. A probe that needs four
  # attempts to read one 32-bit IDCODE will not carry a 4.9 MB bitstream; fix
  # the cable, do not raise this number until it passes.
  local tries=${JTAG_SCAN_TRIES:-10} attempt=0
  scan=""
  while [ "$attempt" -lt "$tries" ]; do
    attempt=$((attempt + 1))
    scan=$("$qpgm" -c "$cable" -a 2>/dev/null) || true
    grep -qE '^[[:space:]]*[0-9A-Fa-f]{8}[[:space:]]' <<<"$scan" && break
  done
  # Chain rows look like:  "  020F70DD   10CL120(Y|Z)/EP3C120/.."
  # `|| true` is load-bearing: with `set -e` + `pipefail` a no-match grep makes
  # this assignment fail, and the function exits HERE -- silently, rc=1, with
  # none of the diagnosis below ever printed. A powered-off board looked
  # identical to a missing quartus_pgm.
  found=$(grep -oE '^[[:space:]]*[0-9A-Fa-f]{8}[[:space:]]' <<<"$scan" | tr -d '[:space:]' | head -1) || true
  if [ -z "$found" ]; then
    echo "JTAG chain scan on '$cable' found no device in $tries attempts." >&2
    grep -q 'chain broken' <<<"$scan" \
      && echo "  quartus_pgm: JTAG chain broken -- the cable enumerated but TDO came back empty." >&2
    echo "  Usual cause is the BOARD being powered off; then a JTAG header that is" >&2
    echo "  unplugged, reversed, or (on a level-shifted cable) missing its Vref." >&2
    echo "  NOTE quartus_pgm exits 0 on a broken chain, so only this check catches it." >&2
    return 1
  fi
  found=${found^^}
  if [ "$expect" = "?" ]; then
    echo "IDCODE for '$want' is not recorded yet. Detected $found on '$cable'." >&2
    echo "If that is the $label, add it to the DEVICES table in $0." >&2
    return 1
  fi
  if [ "$found" = "$expect" ]; then
    if [ "$attempt" -gt 1 ]; then
      # A cable needing retries is MARGINAL, not working. Saying so is the
      # point: reporting a plain pass hides the thing that wastes the afternoon.
      echo "FLAKY CABLE '$cable': chain read on attempt $attempt of $tries." >&2
      echo "  At 6 MHz on a level-shifted flying-lead probe this is usually" >&2
      echo "  signal integrity -- lead length, coupling, or a borderline Vref" >&2
      echo "  on header pin 4. Expect intermittent programming failures." >&2
    fi
    echo "$found  ($label)"
  else
    echo "WRONG BOARD on '$cable': IDCODE $found, expected $expect for alias '$want' ($label)." >&2
    echo "Check which cable is on which board -- \`$0\` lists probe/board pairs." >&2
    return 1
  fi
}

serial_for_alias() {
  local want="$1" line
  while IFS='|' read -r alias serial kind desc; do
    [ "$alias" = "$want" ] && { echo "$serial"; return 0; }
  done <<<"$BOARDS"
  echo "unknown board alias: $want" >&2
  echo "known:" >&2
  while IFS='|' read -r alias serial kind desc; do echo "  $alias" >&2; done <<<"$BOARDS"
  return 1
}

serial_matches() {
  # true when either serial is a case-insensitive prefix of the other. A Pico
  # reports 16 hex chars of its unique ID under dirtyJtag but only the first 8
  # under pico-usb-blaster, so the same board matches across firmware swaps.
  local a="${1,,}" b="${2,,}"
  [ -n "$a" ] && [ -n "$b" ] || return 1
  [ "${a:0:${#b}}" = "$b" ] || [ "${b:0:${#a}}" = "$a" ]
}

alias_for_serial() {
  local want="$1"
  while IFS='|' read -r alias serial kind desc; do
    serial_matches "$want" "$serial" && { echo "$alias"; return 0; }
  done <<<"$BOARDS"
  echo "-"
}

# Walk sysfs and emit: portpath vidpid serial bus dev kind
enumerate() {
  local d v p s bus dev
  for d in /sys/bus/usb/devices/[0-9]*-[0-9]*/; do
    [ -e "$d/idVendor" ] || continue
    v=$(cat "$d/idVendor"); p=$(cat "$d/idProduct")
    is_probe_id "$v:$p" || continue
    s=$(cat "$d/serial" 2>/dev/null || echo "")
    bus=$(cat "$d/busnum"); dev=$(cat "$d/devnum")
    printf '%s %s:%s %s %s %s %s\n' \
      "$(basename "$d")" "$v" "$p" "${s:--}" "$bus" "$dev" "$(probe_kind "$v:$p" "${s:-}")"
  done
}

find_by_serial() {
  local want="$1" path vidpid serial bus dev kind
  while read -r path vidpid serial bus dev kind; do
    serial_matches "$serial" "$want" && { echo "$path $vidpid $serial $bus $dev $kind"; return 0; }
  done < <(enumerate)
  return 1
}

cmd_list() {
  printf '%-8s %-11s %-18s %-8s %-12s %s\n' PORT VID:PID SERIAL BUS:DEV KIND BOARD
  local path vidpid serial bus dev kind
  while read -r path vidpid serial bus dev kind; do
    printf '%-8s %-11s %-18s %-8s %-12s %s\n' \
      "$path" "$vidpid" "$serial" "$(printf '%03d:%03d' "$bus" "$dev")" \
      "$kind" "$(alias_for_serial "$serial")"
  done < <(enumerate)
}

cmd_health() {
  local out
  out=$(dmesg 2>/dev/null || sudo dmesg 2>/dev/null) || {
    echo "cannot read dmesg" >&2; return 1; }
  echo "Per-port USB enumeration health this boot."
  echo "Repeated enumerations or descriptor errors mean an unstable link. Usual"
  echo "causes: the probe losing power (a Pico fed from the FPGA board dies when"
  echo "that board browns out), a bad cable, or passthrough churn from replugging"
  echo "and BOOTSEL cycles. NOTE: under a VM these port numbers are virtual, so a"
  echo "'bad port' is not necessarily a physical socket."
  echo
  printf '%-8s %-12s %-14s %s\n' PORT ENUMERATIONS DESC_ERRORS VERDICT
  local p n m verdict
  for p in $(grep -oE 'usb [0-9]+-[0-9]+' <<<"$out" | awk '{print $2}' | sort -u); do
    m=$(grep -c "usb $p: new " <<<"$out" || true)
    n=$(grep -c "usb $p: device descriptor" <<<"$out" || true)
    verdict=ok
    [ "$n" -gt 0 ] && verdict="SUSPECT"
    [ "$m" -gt 10 ] && verdict="BAD (re-enumerating)"
    printf '%-8s %-12s %-14s %s\n' "$p" "$m" "$n" "$verdict"
  done
}

main() {
  case "${1:-}" in
    ""|--list) cmd_list ;;
    --boards)
      printf '%-12s %-18s %-12s %s\n' ALIAS SERIAL KIND DESCRIPTION
      while IFS='|' read -r alias serial kind desc; do
        printf '%-12s %-18s %-12s %s\n' "$alias" "$serial" "$kind" "$desc"
      done <<<"$BOARDS" ;;
    --health) cmd_health ;;
    --serial) serial_for_alias "${2:?alias required}" ;;
    --cable)
      s=$(serial_for_alias "${2:?alias required}")
      if ! r=$(find_by_serial "$s"); then
        echo "probe for '$2' (serial $s) is NOT attached" >&2; exit 1
      fi
      # Quartus names a cable "<usb product string> [<port path>]". Read the
      # product rather than assuming: the real Altera cable reports
      # "USB-Blaster", pico-usb-blaster reports "USB Blaster" (no hyphen).
      port=$(awk '{print $1}' <<<"$r")
      prod=$(cat "/sys/bus/usb/devices/$port/product" 2>/dev/null || echo "USB-Blaster")
      echo "$prod [$port]" ;;
    --assert-device) assert_device "${2:?alias required}" "${3:-}" ;;
    --busdev)
      s=$(serial_for_alias "${2:?alias required}")
      if ! r=$(find_by_serial "$s"); then
        echo "probe for '$2' (serial $s) is NOT attached" >&2; exit 1
      fi
      awk '{printf "%d:%d\n", $4, $5}' <<<"$r" ;;
    -h|--help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
