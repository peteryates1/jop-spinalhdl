#!/usr/bin/env bash
# Map JTAG probes to the selector each tool wants, resolved at run time from the
# probe's USB serial number.
#
# Port paths (1-4, 1-7, ...) move when you replug, so nothing here hardcodes
# them. Serial numbers are fixed per probe, so a board alias resolves to a
# serial, and the serial resolves to whatever the tool needs right now:
#
#   Quartus          cable name "<usb product> [<port-path>]" -- the suffix IS
#                    the sysfs port path, and the prefix is the USB product
#                    string, which differs between a real Altera cable
#                    ("USB-Blaster") and pico-usb-blaster ("USB Blaster")
#   openFPGALoader   --busdev-num <bus>:<dev> -- BUT ONLY WITH THE PATCHED
#                    BUILD. Stock openFPGALoader (including the Debian package)
#                    accepts --busdev-num and --cable-index and IGNORES BOTH:
#                    libusb_open_device_with_vid_pid() returns the first match,
#                    so with two identical probes it always takes whichever
#                    enumerated first. Verified 2026-08-07 by asking for a
#                    bus:dev that does not exist -- it happily detected a chip.
#                    Fix: ~/workspaces/openfpgaloader-dirtyjtag-busdev.patch,
#                    built and installed to /usr/local/bin (shadows the .deb).
#                    A patched build FAILS on a bogus bus:dev; that is the test.
#                    NOTE the patch covers dirtyJtag only -- the usb-blaster
#                    driver still has the same bug.
#
# COMING: a second blaster (pico-usb-blaster, once level shifters arrive for the
# A-E115FB's 1.8V JTAG). Two blasters attached at once means selection must be by
# USB ADDRESS, not by product name:
#   - Quartus is fine. Always pass the PORT-QUALIFIED name from `--cable`
#     ("USB-Blaster [1-6]"); a bare "USB-Blaster" takes the first product-string
#     match. Board Makefiles should never hardcode the bare string -- the
#     EP4CGX150 one did until 2026-08-17.
#   - openFPGALoader is NOT fine: the patch above covers dirtyJtag only, so its
#     usb-blaster driver still ignores --busdev-num and grabs the first match.
#     Use Quartus for usb-blaster cables until that is patched too.
#   - Lucky break: the product strings differ ("USB-Blaster" vs "USB Blaster"),
#     so the two are distinguishable even before the port path is considered.
#
# Companion to usb_serial_map, which does the same job for serial ports.
set -euo pipefail

# --- board registry ------------------------------------------------------
# alias|serial|kind|description
BOARDS=$(cat <<'EOF'
terasic|91d28408|usb-blaster|Terasic USB-Blaster — a CABLE, not a board: move it between boards freely
xc7a100t|E662C876|pico|QMTECH XC7A100T + DB_FPGA V5 (Pico: dirtyJtag or usb-blaster)
ae115fb|91d28408|usb-blaster|A-E115FB EP4CE115 + 1GB DDR2 — on the Terasic cable; its Pico (E6616408) is 3.3V into a 1.8V-banked JTAG, blocked on level shifters
ep4cgx150|91d28408|usb-blaster|QMTECH EP4CGX150 + SDR — also on the Terasic cable; SWAPS with ae115fb, so ALWAYS --assert-device before programming
debugprobe|E6647C740343412F|cmsis-dap|Raspberry Pi Debug Probe (SWD, for flashing Picos)
cyc5000|ARA30135|arrow-usb-blaster|Arrow CYC5000 (onboard Arrow USB Blaster TEI0050, FT2232H)
i5|07000001002700424e|cmsis-dap|Colorlight i5 on the ext board (DAPLink, also the UART bridge)
wukong|0B383D0435D957EC|pico|QMTECH Wukong XC7A100T (Pico 2 W: dirtyJtag, or USB-Blaster emulation under the atari800 supervisor firmware)
alchitry|000000|ftdi-xilinx|Alchitry Au V2 (XC7A35T + DDR3) — onboard FT2232H, programmed by Vivado hw_server (see fpga/alchitry-au). Shares vid:pid 0403:6010 with the CYC5000's Arrow blaster; the serial and product string are what separate them. fpga/alchitry-au-ddr3-test is a second PROJECT on this same board, not another board
EOF
)

# vid:pid values we recognise as JTAG probes
is_probe_id() {
  case "${1,,}" in
    1209:c0ca|09fb:6001|2e8a:000c|0403:6010|0d28:0204) return 0 ;;
    *) return 1 ;;
  esac
}

probe_kind() {
  case "${1,,}" in
    1209:c0ca) echo "dirtyjtag" ;;
    09fb:6001) echo "usb-blaster" ;;
    2e8a:000c) echo "cmsis-dap" ;;
    # Arrow's onboard blaster is an FT2232H, so it shares a vid:pid with every
    # other FTDI dual-UART part -- including the Alchitry Au V2's. The SERIAL is
    # what separates them, so this case takes it as a second argument rather
    # than calling everything on 0403:6010 an Arrow blaster: the listing said
    # "arrow-usb-blaster" against the Alchitry, which is a different board's
    # probe. A listing that names the wrong probe is worse than one saying
    # "unknown", and this one helped conclude the Alchitry was not attached.
    0403:6010) case "${2:-}" in
                 ARA*) echo "arrow-usb-blaster" ;;
                 000000) echo "ftdi-xilinx" ;;
                 *) echo "ftdi-ft2232h" ;;
               esac ;;
    0d28:0204) echo "cmsis-dap" ;;
    *) echo "unknown" ;;
  esac
}

usage() {
  cat <<'USAGE'
Usage:
  jtag_probe_map                    list every attached JTAG probe
  jtag_probe_map --cable <alias>    print the Quartus cable name for a board
  jtag_probe_map --busdev <alias>   print bus:dev for openFPGALoader
  jtag_probe_map --serial <alias>   print the probe serial for a board
  jtag_probe_map --health           per-port USB enumeration health (needs dmesg)
  jtag_probe_map --boards           list known board aliases
  jtag_probe_map --assert-device <alias> [cable]
                                    scan the JTAG chain; fail unless the FPGA
                                    on it is the one <alias> expects

Aliases: terasic, xc7a100t, ae115fb, ep4cgx150, debugprobe, cyc5000, i5, wukong

NOTE: an alias names whatever the SERIAL is attached to. A Pico is soldered to
one board so its alias names that board; a standalone cable like the Terasic
moves, so it is named for the cable and you pick the board by plugging it in.

THE TWO ALTERA BOARDS SHARE THE TERASIC CABLE. `ae115fb` and `ep4cgx150` both
resolve to it, so the alias alone does NOT tell you which board is plugged in,
and programming the wrong one succeeds silently. Any `program` target for those
two must run `--assert-device` first; it is a read-only chain scan and
configures nothing.

Examples:
  quartus_pgm -c "$(jtag_probe_map --cable ep4cgx150)" -m JTAG foo.cdf
  jtag_probe_map --assert-device ae115fb || exit 1   # before programming
  openFPGALoader -c dirtyJtag --busdev-num "$(jtag_probe_map --busdev xc7a100t)" foo.bit
USAGE
}

# --- expected FPGA per board ---------------------------------------------
# Only needed for boards that SHARE a cable. An alias normally names a probe
# soldered to one board, so the alias implies the board. The Terasic blaster is
# a loose cable serving BOTH Altera boards (the A-E115FB's own Pico drives 3.3V
# into a 1.8V-banked JTAG and is blocked on level shifters), so `--cable
# ae115fb` and `--cable ep4cgx150` return the SAME cable and the alias no longer
# proves which board is on the end of it. Programming the wrong board is
# otherwise completely silent -- it succeeds.
#
# Keyed by JTAG IDCODE, NOT by device name. quartus_pgm reports the whole set of
# IDCODE-compatible parts and TRUNCATES it -- the A-E115FB's EP4CE115 prints as
# "10CL120(Y|Z)/EP3C120/.." because Cyclone IV E, Cyclone III and Cyclone 10 LP
# share IDCODE 020F70DD, and the name we want is inside the "..". Matching names
# therefore reports the wrong board on a correct one. The IDCODE itself is
# unambiguous, and it separates the two boards that share this cable, which is
# all this check has to do.
#
# alias|idcode|what it is.  idcode "?" = not yet recorded: the check then prints
# the detected value and asks for it, rather than guessing.
DEVICES=$(cat <<'EOF'
ae115fb|020F70DD|EP4CE115 (IDCODE shared with EP3C120 / 10CL120)
ep4cgx150|028040DD|EP4CGX150 — Cyclone IV GX
EOF
)

# Scan the JTAG chain and fail unless the expected FPGA is the one attached.
# Read-only: it configures nothing.
assert_device() {
  local want="$1" cable="${2:-}" expect label found scan qpgm
  expect=""; label=""
  while IFS='|' read -r a i d; do
    [ "$a" = "$want" ] && { expect="$i"; label="$d"; break; }
  done <<<"$DEVICES"
  if [ -z "$expect" ]; then
    echo "no expected IDCODE recorded for '$want' -- nothing to check" >&2; return 0
  fi
  [ -n "$cable" ] || cable=$("$0" --cable "$want") || return 1
  qpgm=${QUARTUS_PGM:-/opt/altera/18.1/quartus/bin/quartus_pgm}
  [ -x "$qpgm" ] || { echo "quartus_pgm not found at $qpgm (set QUARTUS_PGM)" >&2; return 1; }
  scan=$("$qpgm" -c "$cable" -a 2>/dev/null) || true
  # Chain rows look like:  "  020F70DD   10CL120(Y|Z)/EP3C120/.."
  found=$(grep -oE '^[[:space:]]*[0-9A-Fa-f]{8}[[:space:]]' <<<"$scan" | tr -d '[:space:]' | head -1)
  if [ -z "$found" ]; then
    echo "JTAG chain scan on '$cable' found no device -- board powered off, or cable on nothing" >&2
    return 1
  fi
  found=${found^^}
  if [ "$expect" = "?" ]; then
    echo "IDCODE for '$want' is not recorded yet. Detected $found on '$cable'." >&2
    echo "If that is the $label, add it to the DEVICES table in $0." >&2
    return 1
  fi
  if [ "$found" = "$expect" ]; then
    echo "$found  ($label)"
  else
    echo "WRONG BOARD on '$cable': IDCODE $found, expected $expect for alias '$want' ($label)." >&2
    echo "The Terasic blaster is shared between the two Altera boards -- move the cable." >&2
    return 1
  fi
}

serial_for_alias() {
  local want="$1" line
  while IFS='|' read -r alias serial kind desc; do
    [ "$alias" = "$want" ] && { echo "$serial"; return 0; }
  done <<<"$BOARDS"
  echo "unknown board alias: $want" >&2
  echo "known:" >&2
  while IFS='|' read -r alias serial kind desc; do echo "  $alias" >&2; done <<<"$BOARDS"
  return 1
}

serial_matches() {
  # true when either serial is a case-insensitive prefix of the other. A Pico
  # reports 16 hex chars of its unique ID under dirtyJtag but only the first 8
  # under pico-usb-blaster, so the same board matches across firmware swaps.
  local a="${1,,}" b="${2,,}"
  [ -n "$a" ] && [ -n "$b" ] || return 1
  [ "${a:0:${#b}}" = "$b" ] || [ "${b:0:${#a}}" = "$a" ]
}

alias_for_serial() {
  local want="$1"
  while IFS='|' read -r alias serial kind desc; do
    serial_matches "$want" "$serial" && { echo "$alias"; return 0; }
  done <<<"$BOARDS"
  echo "-"
}

# Walk sysfs and emit: portpath vidpid serial bus dev kind
enumerate() {
  local d v p s bus dev
  for d in /sys/bus/usb/devices/[0-9]*-[0-9]*/; do
    [ -e "$d/idVendor" ] || continue
    v=$(cat "$d/idVendor"); p=$(cat "$d/idProduct")
    is_probe_id "$v:$p" || continue
    s=$(cat "$d/serial" 2>/dev/null || echo "")
    bus=$(cat "$d/busnum"); dev=$(cat "$d/devnum")
    printf '%s %s:%s %s %s %s %s\n' \
      "$(basename "$d")" "$v" "$p" "${s:--}" "$bus" "$dev" "$(probe_kind "$v:$p" "${s:-}")"
  done
}

find_by_serial() {
  local want="$1" path vidpid serial bus dev kind
  while read -r path vidpid serial bus dev kind; do
    serial_matches "$serial" "$want" && { echo "$path $vidpid $serial $bus $dev $kind"; return 0; }
  done < <(enumerate)
  return 1
}

cmd_list() {
  printf '%-8s %-11s %-18s %-8s %-12s %s\n' PORT VID:PID SERIAL BUS:DEV KIND BOARD
  local path vidpid serial bus dev kind
  while read -r path vidpid serial bus dev kind; do
    printf '%-8s %-11s %-18s %-8s %-12s %s\n' \
      "$path" "$vidpid" "$serial" "$(printf '%03d:%03d' "$bus" "$dev")" \
      "$kind" "$(alias_for_serial "$serial")"
  done < <(enumerate)
}

cmd_health() {
  local out
  out=$(dmesg 2>/dev/null || sudo dmesg 2>/dev/null) || {
    echo "cannot read dmesg" >&2; return 1; }
  echo "Per-port USB enumeration health this boot."
  echo "Repeated enumerations or descriptor errors mean an unstable link. Usual"
  echo "causes: the probe losing power (a Pico fed from the FPGA board dies when"
  echo "that board browns out), a bad cable, or passthrough churn from replugging"
  echo "and BOOTSEL cycles. NOTE: under a VM these port numbers are virtual, so a"
  echo "'bad port' is not necessarily a physical socket."
  echo
  printf '%-8s %-12s %-14s %s\n' PORT ENUMERATIONS DESC_ERRORS VERDICT
  local p n m verdict
  for p in $(grep -oE 'usb [0-9]+-[0-9]+' <<<"$out" | awk '{print $2}' | sort -u); do
    m=$(grep -c "usb $p: new " <<<"$out" || true)
    n=$(grep -c "usb $p: device descriptor" <<<"$out" || true)
    verdict=ok
    [ "$n" -gt 0 ] && verdict="SUSPECT"
    [ "$m" -gt 10 ] && verdict="BAD (re-enumerating)"
    printf '%-8s %-12s %-14s %s\n' "$p" "$m" "$n" "$verdict"
  done
}

main() {
  case "${1:-}" in
    ""|--list) cmd_list ;;
    --boards)
      printf '%-12s %-18s %-12s %s\n' ALIAS SERIAL KIND DESCRIPTION
      while IFS='|' read -r alias serial kind desc; do
        printf '%-12s %-18s %-12s %s\n' "$alias" "$serial" "$kind" "$desc"
      done <<<"$BOARDS" ;;
    --health) cmd_health ;;
    --serial) serial_for_alias "${2:?alias required}" ;;
    --cable)
      s=$(serial_for_alias "${2:?alias required}")
      if ! r=$(find_by_serial "$s"); then
        echo "probe for '$2' (serial $s) is NOT attached" >&2; exit 1
      fi
      # Quartus names a cable "<usb product string> [<port path>]". Read the
      # product rather than assuming: the real Altera cable reports
      # "USB-Blaster", pico-usb-blaster reports "USB Blaster" (no hyphen).
      port=$(awk '{print $1}' <<<"$r")
      prod=$(cat "/sys/bus/usb/devices/$port/product" 2>/dev/null || echo "USB-Blaster")
      echo "$prod [$port]" ;;
    --assert-device) assert_device "${2:?alias required}" "${3:-}" ;;
    --busdev)
      s=$(serial_for_alias "${2:?alias required}")
      if ! r=$(find_by_serial "$s"); then
        echo "probe for '$2' (serial $s) is NOT attached" >&2; exit 1
      fi
      awk '{printf "%d:%d\n", $4, $5}' <<<"$r" ;;
    -h|--help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
