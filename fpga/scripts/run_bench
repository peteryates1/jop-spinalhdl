#!/usr/bin/env bash
# Program a board and run a .jop on it, capturing the UART.
#
#   run_bench <board> <bitstream> <app.jop> [seconds]
#
#   run_bench ae115fb   .../jop_ddr2_smp.sof   java/apps/JbeBench/JbeScale.jop 90
#   run_bench wukong    .../JopSmpDdr3WukongTop.bit java/apps/JbeBench/JbeScale.jop 90
#   run_bench ep4cgx150 .../jop_sdram.sof      java/apps/JbeBench/JbeBench.jop 240
#
# Three things this exists to get right, each of which cost real time:
#
#  1. REPROGRAM BEFORE EVERY DOWNLOAD. The serial boot loader only runs out of
#     reset, and a previous download attempt consumes the ready handshake. The
#     board then looks completely silent, which is indistinguishable from a dead
#     bitstream and sends you debugging the wrong thing.
#
#  2. ASSERT THE DEVICE. The two Altera boards have separate cables since
#     2026-08-29, but quartus_pgm EXITS 0 ON A BROKEN CHAIN, so a powered-off
#     board still "programs successfully". The scan is the only thing that
#     notices -- and two blasters are attached, so a mis-resolved cable would
#     program the other board just as silently.
#
#  3. THE BAUD IS PER BOARD. It used to be per board AND not always round:
#     Wukong DDR3 at MigProfile.Ddr3_366 runs ui_clk at 91.676 MHz, and the old
#     integer divider turned a requested 2 Mbaud into 2.0372. Fixed 2026-08-18
#     by jop.io.UartBaudTick, so every board is now the round number it asks
#     for -- but bitstreams built BEFORE that date still need 2037000. If a
#     board seems dead,
#     listen RAW across a sweep of bauds before believing it — a mis-clocked
#     build transmits a stable byte that decodes to 0xAA at no standard rate,
#     and the ratio that does decode tells you the real clock.
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
BOARD="${1:?board alias: ae115fb | wukong | ep4cgx150}"
BIT="${2:?bitstream}"
APP="${3:?app .jop}"
SECS="${4:-120}"
cd "$ROOT" || exit 1

case "$BOARD" in
  ae115fb)   UART=/dev/ttyUSB0; BAUD=2000000; KIND=quartus ;;
  ep4cgx150) UART=/dev/ttyUSB1; BAUD=2000000; KIND=quartus ;;
  wukong)    UART=$(./fpga/scripts/usb_serial_map 2>/dev/null | awk '/1a86:7523/{print $1; exit}')
             BAUD=2000000; KIND=openfpgaloader ;;   # 2037000 before 2026-08-18
  *) echo "unknown board '$BOARD'"; exit 2 ;;
esac
[ -n "${UART:-}" ] || { echo "no UART found for $BOARD"; exit 2; }

# The IDCODE guard is only meaningful once the alias has one recorded; it is a
# warning otherwise, so a missing entry silently disables the protection.
if ! ./fpga/scripts/jtag_probe_map --assert-device "$BOARD" >/dev/null 2>&1; then
  echo "ABORT: $BOARD is not the device on its cable"
  ./fpga/scripts/jtag_probe_map --assert-device "$BOARD"
  exit 2
fi

echo "=== $BOARD  uart=$UART @ $BAUD"
case "$KIND" in
  quartus)
    CABLE=$(./fpga/scripts/jtag_probe_map --cable "$BOARD")
    /opt/altera/18.1/quartus/bin/quartus_pgm -c "$CABLE" -m JTAG -o "p;$BIT" 2>&1 | tail -2 ;;
  openfpgaloader)
    BUSDEV=$(./fpga/scripts/jtag_probe_map --busdev "$BOARD")
    openFPGALoader -c dirtyJtag --busdev-num "$BUSDEV" "$BIT" 2>&1 | tail -1 ;;
esac
sleep 2
timeout "$SECS" python3 -u fpga/scripts/download.py -e "$APP" "$UART" "$BAUD" 2>&1
