# fpga-db-colorlight-i5 + Colorlight i5 v7.0: Ethernet stage 2 (RGMII, 100 Mb/s).
# Module pins: wuxx Colorlight-FPGA-Projects README (ETH-PHY0 U28, ETH-PHY1 U29)
# and LiteX colorlight_i5.py (_io_v7_0) agree ball for ball. Index 0 = MDIO 0 by
# LiteX's numbering (its eth 0, U29), index 1 = MDIO 1 (eth 1, U28). Base-board
# pins are SODIMM pins from the 2026-10-10 netlist via ColorlightSodimm.SodimmI5.
# P4, the shared PHY reset, is NOT driven.
LOCATE COMP "clk25" SITE "P3";
IOBUF PORT "clk25" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk25" 25 MHZ;
LOCATE COMP "uart_tx" SITE "E1";   # SODIMM 153 = GPIO5, stamp uart1 RX (CDC0)
IOBUF PORT "uart_tx" IO_TYPE=LVCMOS33;
LOCATE COMP "mdc" SITE "N5";
IOBUF PORT "mdc" IO_TYPE=LVCMOS33;
LOCATE COMP "mdio" SITE "P5";
IOBUF PORT "mdio" IO_TYPE=LVCMOS33 PULLMODE=UP;
# PHY index 0: U29
LOCATE COMP "txc[0]" SITE "G1";   # GTXCLK
IOBUF PORT "txc[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "tx_ctl[0]" SITE "K1";   # TX_EN
IOBUF PORT "tx_ctl[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "txd0[0]" SITE "G2";
IOBUF PORT "txd0[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "txd0[1]" SITE "H1";
IOBUF PORT "txd0[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "txd0[2]" SITE "J1";
IOBUF PORT "txd0[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "txd0[3]" SITE "J3";
IOBUF PORT "txd0[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxc[0]" SITE "H2";   # RXC
IOBUF PORT "rxc[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "rx_ctl[0]" SITE "P2";   # RX_DV
IOBUF PORT "rx_ctl[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxd0[0]" SITE "K2";
IOBUF PORT "rxd0[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxd0[1]" SITE "L1";
IOBUF PORT "rxd0[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxd0[2]" SITE "N1";
IOBUF PORT "rxd0[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxd0[3]" SITE "P1";
IOBUF PORT "rxd0[3]" IO_TYPE=LVCMOS33;
# PHY index 1: U28
LOCATE COMP "txc[1]" SITE "U19";   # GTXCLK
IOBUF PORT "txc[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "tx_ctl[1]" SITE "P19";   # TX_EN
IOBUF PORT "tx_ctl[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "txd1[0]" SITE "U20";
IOBUF PORT "txd1[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "txd1[1]" SITE "T19";
IOBUF PORT "txd1[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "txd1[2]" SITE "T20";
IOBUF PORT "txd1[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "txd1[3]" SITE "R20";
IOBUF PORT "txd1[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxc[1]" SITE "L19";   # RXC
IOBUF PORT "rxc[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "rx_ctl[1]" SITE "M20";   # RX_DV
IOBUF PORT "rx_ctl[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxd1[0]" SITE "P20";
IOBUF PORT "rxd1[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxd1[1]" SITE "N19";
IOBUF PORT "rxd1[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxd1[2]" SITE "N20";
IOBUF PORT "rxd1[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "rxd1[3]" SITE "M19";
IOBUF PORT "rxd1[3]" IO_TYPE=LVCMOS33;
# 125 MHz: at 1000BASE-T, before the MDIO writes force 100, the PHYs send a 125 MHz RXC
FREQUENCY PORT "rxc[0]" 125 MHZ;
FREQUENCY PORT "rxc[1]" 125 MHZ;
# base board, by SODIMM pin
LOCATE COMP "led[0]" SITE "T3";   # SODIMM 66 = LED0
IOBUF PORT "led[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[1]" SITE "M3";   # SODIMM 64 = LED1
IOBUF PORT "led[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[2]" SITE "T2";   # SODIMM 62 = LED2
IOBUF PORT "led[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[3]" SITE "N3";   # SODIMM 60 = LED3
IOBUF PORT "led[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[4]" SITE "N2";   # SODIMM 58 = LED4
IOBUF PORT "led[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[5]" SITE "M1";   # SODIMM 54 = LED5
IOBUF PORT "led[5]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[6]" SITE "V1";   # SODIMM 52 = LED6
IOBUF PORT "led[6]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[7]" SITE "W1";   # SODIMM 50 = LED7
IOBUF PORT "led[7]" IO_TYPE=LVCMOS33;
LOCATE COMP "eth_led[0]" SITE "K18";   # SODIMM 49 = ETH1_LED-L+ (RJ1 left)
IOBUF PORT "eth_led[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "eth_led[1]" SITE "C18";   # SODIMM 51 = ETH1_LED-R+ (RJ1 right)
IOBUF PORT "eth_led[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "led_n" SITE "U16";   # module LED D2 (also SODIMM 41: no net here)
IOBUF PORT "led_n" IO_TYPE=LVCMOS33;
# buttons to GND, no board pull-ups; only RESET is fitted on the second board
LOCATE COMP "sw_n[0]" SITE "R1";   # SODIMM 42 = SW_RESET
IOBUF PORT "sw_n[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "sw_n[1]" SITE "T1";   # SODIMM 44 = SW_OPTION
IOBUF PORT "sw_n[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "sw_n[2]" SITE "U1";   # SODIMM 46 = SW_SELECT
IOBUF PORT "sw_n[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "sw_n[3]" SITE "Y2";   # SODIMM 48 = SW_START
IOBUF PORT "sw_n[3]" IO_TYPE=LVCMOS33 PULLMODE=UP;
