# =============================================================================
# A-E115FB DDR2 exerciser — EP4CE115F23I7 + 1 GB DDR2 SODIMM
#
# First hardware milestone of the DDR2 bring-up: drives the ALTMEMPHY local
# interface directly, with no cache/adapter/JOP, so a failure isolates to the IP,
# the pin constraints or calibration. See docs/boards/ae115fb-ddr2-bringup.md.
#
# The DDR2 controller IP is NOT in this repo — it is vendor-generated (ALTMEMPHY
# 13.1, ~3.7 MB of Verilog) and Quartus cannot regenerate it after 18.1. The
# Makefile links it in from DDR2_IP_DIR at build time.
# =============================================================================

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F23I7
set_global_assignment -name TOP_LEVEL_ENTITY Ddr2ExerciserTop
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# --- sources -----------------------------------------------------------------
set_global_assignment -name VERILOG_FILE ../../spinalhdl/generated/Ddr2ExerciserTop.v
set_global_assignment -name QIP_FILE ip/ddr2_64bit/ddr2_64bit.qip

# --- board pins --------------------------------------------------------------
# CLK25M on the core board; KEY1 as reset (active low).
set_location_assignment PIN_AB11 -to clk
set_location_assignment PIN_N21  -to rst_n
# These sit in banks shared with the DDR2 interface, whose VCCIO is 1.8 V, so
# they must use the 1.8 V standard — exactly what the vendor reference does.
set_instance_assignment -name IO_STANDARD "1.8 V" -to clk
set_instance_assignment -name IO_STANDARD "1.8 V" -to rst_n

# Core-board LEDs D3..D6, active low.
set_location_assignment PIN_A5 -to led[0]
set_location_assignment PIN_B5 -to led[1]
set_location_assignment PIN_C4 -to led[2]
set_location_assignment PIN_C3 -to led[3]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led[0]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led[1]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led[2]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led[3]

# On-board CH340 UART. FPGA TX -> CH340 RX is H5; CH340 TX -> FPGA RX is N1.
# Both verified working by the loopback in commit a32434b.
set_location_assignment PIN_H5 -to uart_tx
set_location_assignment PIN_N1 -to uart_rx
# H5/N1 fit in banks 1 and 2, which are NOT part of the 1.8 V DDR2 group, so
# they can and should be 3.3 V for the CH340. Left unconstrained they defaulted
# to 2.5 V, which is marginal into a 3.3 V receiver.
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_tx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_rx

# --- DDR2 SODIMM (494 lines, extracted from the vendor reference) -------------
source ddr2_pins.qsf

# mem_addr[10] lands on K22, which doubles as the nCEO configuration pin, so it
# has to be released for regular I/O — the vendor reference does the same.
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

# Unused pins as inputs tri-stated: the SODIMM and the bottom board share nets we
# are not driving in this design.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
