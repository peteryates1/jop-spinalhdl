# =============================================================================
# JOP on the A-E115FB — EP4CE115F23I7 + 1 GB DDR2 SODIMM
#
# Second revision alongside ddr2_exerciser, sharing ddr2_pins.qsf and the
# regenerated IP in ip/. The exerciser proves the memory; this runs JOP on it.
#
#   make PROJECT=jop_ddr2 all
# =============================================================================

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F23I7
set_global_assignment -name TOP_LEVEL_ENTITY JopDdr2Ae115fbTop
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name VERILOG_FILE ../../spinalhdl/generated/JopDdr2Ae115fbTop.v
set_global_assignment -name QIP_FILE ip/ddr2_64bit/ddr2_64bit.qip
# Altera LPM wrappers backing the generated `rom`/`ram` blackboxes — the same
# files the EP4CGX150 project uses. Without them synthesis reports the entities
# as undefined.
set_global_assignment -name VHDL_FILE ../../fpga/ip/altera_lpm/arom.vhd
set_global_assignment -name VHDL_FILE ../../fpga/ip/altera_lpm/aram.vhd
set_global_assignment -name SDC_FILE jop_ddr2.sdc

# --- board pins --------------------------------------------------------------
# 25 MHz oscillator feeds the ALTMEMPHY PLL reference; the core itself runs on
# phy_clk (83 MHz) produced by the controller. Reset is KEY1, active low.
set_location_assignment PIN_AB11 -to clk_in
set_location_assignment PIN_N21  -to reset
set_instance_assignment -name IO_STANDARD "1.8 V" -to clk_in
set_instance_assignment -name IO_STANDARD "1.8 V" -to reset

# Core-board LEDs D3..D6, active low, in banks shared with the 1.8 V DDR2 group.
set_location_assignment PIN_A5 -to led[0]
set_location_assignment PIN_B5 -to led[1]
set_location_assignment PIN_C4 -to led[2]
set_location_assignment PIN_C3 -to led[3]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led[0]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led[1]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led[2]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led[3]

# On-board CH340. Banks 1/2 are not part of the DDR2 group, so 3.3 V is both
# legal and correct here.
set_location_assignment PIN_H5 -to ser_txd
set_location_assignment PIN_N1 -to ser_rxd
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ser_txd
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ser_rxd

# --- DDR2 SODIMM -------------------------------------------------------------
source ddr2_pins.qsf

# mem_addr[10] lands on K22, which doubles as the nCEO configuration pin.
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

set_global_assignment -name OPTIMIZE_MULTI_CORNER_TIMING ON
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.1 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_location_assignment PIN_AB10 -to mem_addr[0]
set_location_assignment PIN_K22 -to mem_addr[10]
set_location_assignment PIN_AB6 -to mem_addr[11]
set_location_assignment PIN_V8 -to mem_addr[12]
set_location_assignment PIN_AA20 -to mem_addr[13]
set_location_assignment PIN_L21 -to mem_addr[1]
