# JOP Project .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.pytest_cache/
*.egg-info/
dist/
/build/

# Scala/SBT
**/target/
project/project/
spinalhdl/project/
.bsp/
.metals/
.bloop/
metals.sbt
.scala-build/

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.DS_Store

# Claude Code -- share the project's agents/commands/skills and settings,
# keep machine-local overrides and runtime state out. Allowlist, so anything
# new Claude Code drops in .claude/ is ignored until deliberately un-ignored.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json

# CocoTB
sim_build/
waveforms/
*.ghw
*.vcd
*.fst
results.xml
verification/cocotb/generated/

# GHDL
*.cf
work-obj*.cf

# SpinalHDL generated. This is the ONE output directory: as of 2026-08-18
# every SpinalConfig in spinalhdl/src targets it (the sole exception is
# JopSmallGcQuestaGen -> verification/questa, a separate Questa flow). It is
# what the .qsf/.tcl/Makefile board flows read, via ../../spinalhdl/generated.
spinalhdl/generated/

# Backstop. Before the unification there were four conventions -- bare
# "generated", "generated/verilog", "generated/vhdl", and a dead
# "core/spinalhdl/generated" -- and generated/JopCore.v was tracked, so every
# run of JopCoreVerilog (CI included) dirtied the tree with a spurious diff.
# Nothing writes here now; the rule stays so a reintroduced default cannot
# quietly get committed again.
/generated/
/core/
spinalhdl/*.vhd
spinalhdl/*.v
spinalhdl/simWorkspace/
spinalhdl/tmp/
spinalhdl/spinal/
simWorkspace/

# Quartus build artifacts (project source files .qpf/.qsf/.sdc tracked per project)
**/db/
**/incremental_db/
**/output_files/
*.rpt
*.summary
*.sld
*.jdi
*.pin
*.sof
*.pof
*.cdf
*.done
*.smsg
*.bin
c5_pin_model_dump.txt
*.stp
*.sof.old
*_assignment_defaults.qdf

# Vivado
*.jou
*.log
*.str
.Xil/
*.xpr
**/vivado/build/
**/vivado/ip/*/
!**/vivado/ip/mig.prj
clockInfo.txt
tight_setup_hold_pins.txt

# Questa/ModelSim
verification/questa/
verification/questa-sdram/work/
verification/questa-sdram/sim_*.log
verification/questa-sdram/*.bin
verification/questa-sdram/*.hex
verification/questa-sdram/JopCoreWithSdramTestHarness.v

# Test results
test-history.tsv
test-results/
coverage/
*.coverage
htmlcov/

# Debug traces
mig_trace.csv

# Temporary files
*.tmp
*.bak
*.orig
*_simulation.log

# Java build artifacts
java/tools/dist/
java/runtime/classes/
java/runtime/src/jop/com/jopdesign/sys/Const.java
java/apps/*/build/
java/apps/*/*.jop
java/apps/*/*.jop.txt
java/apps/*/*.jop.link.txt
java/apps/*/*.jop.stats.txt

# Quartus project files for converted boards: written by quartus_sh from the
# generated setup_proj.tcl, so they are build outputs (item 57). Other projects
# in that directory are still hand-written and stay tracked.
fpga/qmtech-ep4cgx150-sdram/jop_sdram.qsf
fpga/qmtech-ep4cgx150-sdram/jop_sdram.qpf
fpga/qmtech-ep4cgx150-sdram/generated/

# Kept-aside binaries for a reproduction that is sensitive to code layout: the
# 4-core generational GC failure only reproduces for a particular image, and any
# runtime edit relinks it away (see docs/current-status.md item 1). Not tracked —
# these are build outputs like every other .jop — but not deleted either.
spinalhdl/repro/

# Microcode assembler generated files
asm/generated/

# Root-level default SpinalHDL output (formal/ad-hoc generation)
/toplevel.v
/*.v_toplevel_*
.cnxerr
qmegawiz_errors_log.txt
